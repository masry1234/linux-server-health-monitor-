 # Server bind settings (loopback is safest; do not expose publicly without authentication).
# SERVERPULSE_HOST=127.0.0.1  # Optional; WSL2 auto-detects its interface IP
SERVERPULSE_PORT=8000

# Enable or disable each notification channel independently.
TELEGRAM_ENABLED=false
EMAIL_ENABLED=false

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP email delivery (587 + STARTTLS is the recommended default).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
